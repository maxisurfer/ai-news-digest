# Local development only — use GitHub Actions secrets in production.
# Copy to .env and fill in values.

# LLM (GitHub Actions: LLM_PROVIDER, GOOGLE_API_KEY, optional LLM_MODEL)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here
# LLM_MODEL=gemini-3.5-flash-lite

# Email (Gmail App Password: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
EMAIL_TO=recipient@example.com

# Discord webhook (channel → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL
# DISCORD_USERNAME=Morning Digest

# Channels: email | discord | email,discord
NOTIFICATION_METHODS=email,discord

# Digest language code (content style is in config.yaml personalization)
AI_RESPONSE_LANGUAGE=en

# Optional local dry run (no sends)
# DRY_RUN=true
